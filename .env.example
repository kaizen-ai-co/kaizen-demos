# ─────────────────────────────────────────────────────────────
# Kaizen demos · variables de entorno (copiar a .env.local)
# Nunca subas llaves reales al repositorio.
# ─────────────────────────────────────────────────────────────

# Proveedor de la capa de datos: memoria | firebase
#  - memoria: desarrollo local y pruebas, sin servicios externos.
#  - firebase: pruebas en Vercel (Auth con Google + Firestore + Storage).
DATOS_PROVEEDOR=memoria

# Identificador del sitio (una demo = un sitio). Lo crea `npm run nueva-demo`.
SITIO_ID=demo-comercial

# Zona horaria del negocio (agenda, fechas de leads, historial).
ZONA_HORARIA=America/Bogota

# Límite de envíos públicos por visitante (formularios, reservas, cotizaciones).
LIMITE_ENVIOS_POR_HORA=5

# ── Firebase (cliente, públicas por diseño) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (servidor, secretas) ──
# JSON de la cuenta de servicio en una sola línea o en base64.
FIREBASE_SERVICE_ACCOUNT=
# Duración de la cookie de sesión en días (máx. 14).
SESION_DIAS=5

# ── Solo desarrollo local con DATOS_PROVEEDOR=memoria ──
# Muestra el selector de cuentas de prueba en /editar (desarrollador, administrador,
# cliente y no autorizada). Se ignora en producción.
ENTRAR_COMO_PRUEBA=1
