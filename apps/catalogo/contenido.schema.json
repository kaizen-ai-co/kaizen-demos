{
  "$schema": "../../packages/editor/esquema.meta.json",
  "plantilla": "catalogo",
  "version": 1,
  "titulo": "Catálogo y cotización",
  "vistas": [
    { "id": "cotizaciones", "titulo": "Cotizaciones", "permiso": "cotizaciones:leer" },
    { "id": "importar", "titulo": "Importar CSV" }
  ],
  "secciones": [
    {
      "id": "encabezado",
      "titulo": "Encabezado",
      "campos": [
        { "id": "marca", "etiqueta": "Nombre de la marca", "tipo": "texto", "requerido": true, "max": 40 },
        { "id": "logo", "etiqueta": "Logo", "tipo": "imagen", "maxBytes": 500000 },
        {
          "id": "textoCotizacion",
          "etiqueta": "Texto del enlace a la cotización",
          "tipo": "texto",
          "max": 24,
          "porDefecto": "Mi cotización"
        }
      ]
    },
    {
      "id": "portada",
      "titulo": "Portada del catálogo",
      "campos": [
        { "id": "titulo", "etiqueta": "Título", "tipo": "texto", "requerido": true, "min": 10, "max": 90 },
        { "id": "subtitulo", "etiqueta": "Subtítulo", "tipo": "textoLargo", "max": 220 }
      ]
    },
    {
      "id": "catalogo",
      "titulo": "Productos y categorías",
      "descripcion": "Todos los precios son ficticios. El id de un producto no debe cambiar después de publicar.",
      "campos": [
        {
          "id": "textoBuscar",
          "etiqueta": "Texto del buscador",
          "tipo": "texto",
          "max": 40,
          "porDefecto": "Buscar productos"
        },
        {
          "id": "textoTodas",
          "etiqueta": "Texto del filtro «todas»",
          "tipo": "texto",
          "max": 20,
          "porDefecto": "Todas"
        },
        {
          "id": "textoAgregar",
          "etiqueta": "Texto del botón agregar",
          "tipo": "texto",
          "max": 24,
          "porDefecto": "Agregar a la cotización"
        },
        {
          "id": "textoAgotado",
          "etiqueta": "Texto de producto no disponible",
          "tipo": "texto",
          "max": 24,
          "porDefecto": "No disponible"
        },
        {
          "id": "textoAgregado",
          "etiqueta": "Texto del botón tras agregar",
          "tipo": "texto",
          "requerido": true,
          "max": 20
        },
        {
          "id": "textoSinResultados",
          "etiqueta": "Texto cuando el filtro no encuentra productos",
          "tipo": "texto",
          "requerido": true,
          "max": 80
        },
        {
          "id": "textoFiltrarCategorias",
          "etiqueta": "Nombre del grupo de filtros (lectores de pantalla)",
          "tipo": "texto",
          "requerido": true,
          "max": 42
        },
        {
          "id": "textoSeccionProductos",
          "etiqueta": "Nombre de la sección de productos (lectores de pantalla)",
          "tipo": "texto",
          "requerido": true,
          "max": 20
        },
        {
          "id": "textoVerCotizacion",
          "etiqueta": "Botón «ver mi cotización» en el detalle del producto",
          "tipo": "texto",
          "requerido": true,
          "max": 34
        },
        {
          "id": "textoVolver",
          "etiqueta": "Enlace «volver al catálogo» en el detalle del producto",
          "tipo": "texto",
          "requerido": true,
          "max": 36
        },
        {
          "id": "categorias",
          "etiqueta": "Categorías",
          "tipo": "lista",
          "minItems": 1,
          "maxItems": 12,
          "nombreItem": "categoría",
          "campoTitulo": "nombre",
          "campos": [
            { "id": "id", "etiqueta": "Id", "tipo": "texto", "requerido": true, "patron": "^[a-z0-9-]+$" },
            { "id": "nombre", "etiqueta": "Nombre", "tipo": "texto", "requerido": true, "max": 30 }
          ]
        },
        {
          "id": "productos",
          "etiqueta": "Productos",
          "tipo": "lista",
          "minItems": 1,
          "maxItems": 200,
          "nombreItem": "producto",
          "campoTitulo": "nombre",
          "campos": [
            { "id": "id", "etiqueta": "Id", "tipo": "texto", "requerido": true, "patron": "^[a-z0-9-]+$", "max": 60 },
            { "id": "nombre", "etiqueta": "Nombre", "tipo": "texto", "requerido": true, "max": 70 },
