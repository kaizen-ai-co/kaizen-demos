            { "id": "descripcion", "etiqueta": "Descripción", "tipo": "textoLargo", "max": 400 },
            {
              "id": "precio",
              "etiqueta": "Precio unitario (ficticio, antes de impuesto)",
              "tipo": "precio",
              "requerido": true,
              "min": 0
            },
            {
              "id": "unidad",
              "etiqueta": "Unidad",
              "tipo": "texto",
              "requerido": true,
              "max": 16,
              "placeholder": "unidad, caja, m²"
            },
            {
              "id": "categoria",
              "etiqueta": "Categoría",
              "tipo": "seleccion",
              "requerido": true,
              "props": { "opcionesDesde": "catalogo.categorias.nombre" }
            },
            { "id": "disponible", "etiqueta": "Disponible", "tipo": "booleano", "porDefecto": true }
          ]
        }
      ]
    },
    {
      "id": "condiciones",
      "titulo": "Condiciones comerciales",
      "campos": [
        {
          "id": "validezDias",
          "etiqueta": "Validez de la cotización (días)",
          "tipo": "numero",
          "requerido": true,
          "min": 1,
          "max": 90
        },
        { "id": "entrega", "etiqueta": "Condiciones de entrega", "tipo": "texto", "requerido": true, "max": 120 },
        { "id": "textoCotizacion", "etiqueta": "Texto al pie de la cotización", "tipo": "textoLargo", "max": 600 },
        {
          "id": "moneda",
          "etiqueta": "Moneda",
          "tipo": "seleccion",
          "opciones": ["COP", "USD"],
          "rol": "desarrollador"
        },
        {
          "id": "nombreImpuesto",
          "etiqueta": "Nombre del impuesto",
          "tipo": "texto",
          "max": 12,
          "rol": "desarrollador",
          "porDefecto": "IVA"
        },
        {
          "id": "tasaImpuesto",
          "etiqueta": "Tasa de impuesto",
          "tipo": "porcentaje",
          "min": 0,
          "max": 1,
          "rol": "desarrollador"
        },
        {
          "id": "descuentoPorcentaje",
          "etiqueta": "Descuento general",
          "tipo": "porcentaje",
          "min": 0,
          "max": 0.5,
          "rol": "desarrollador",
          "ayuda": "Lo aprueba Santiago antes de usarlo con un cliente."
        }
      ]
    },
    {
      "id": "cotizacion",
      "titulo": "Pantalla «Mi cotización»",
      "campos": [
        { "id": "titulo", "etiqueta": "Título", "tipo": "texto", "requerido": true, "max": 60 },
        { "id": "textoVacio", "etiqueta": "Texto cuando está vacía", "tipo": "texto", "max": 120 },
        { "id": "textoBoton", "etiqueta": "Texto del botón enviar", "tipo": "texto", "requerido": true, "max": 28 },
        {
          "id": "mensajeExito",
          "etiqueta": "Mensaje al recibir la cotización",
          "tipo": "textoLargo",
          "requerido": true,
          "max": 200
        },
        { "id": "textoDescargarPdf", "etiqueta": "Botón descargar PDF", "tipo": "texto", "requerido": true, "max": 26 },
        {
          "id": "textoVolver",
          "etiqueta": "Botón «volver al catálogo» tras enviar",
          "tipo": "texto",
          "requerido": true,
          "max": 36
        },
        {
          "id": "textoIrCatalogo",
          "etiqueta": "Botón «ir al catálogo» cuando está vacía",
          "tipo": "texto",
          "requerido": true,
          "max": 28
        },
        { "id": "textoCargando", "etiqueta": "Texto mientras carga", "tipo": "texto", "requerido": true, "max": 20 },
        {
          "id": "textoGenerando",
          "etiqueta": "Texto del botón mientras envía",
          "tipo": "texto",
          "requerido": true,
          "max": 20
        },
        { "id": "textoSubtotal", "etiqueta": "Etiqueta del subtotal", "tipo": "texto", "requerido": true, "max": 20 },
        { "id": "textoTotal", "etiqueta": "Etiqueta del total", "tipo": "texto", "requerido": true, "max": 20 },
        {
          "id": "textoImpuesto",
          "etiqueta": "Etiqueta del impuesto si no tiene nombre",
          "tipo": "texto",
          "requerido": true,
          "max": 20
        },
        {
          "id": "textoSeccionProductos",
          "etiqueta": "Nombre de la lista de productos (lectores de pantalla)",
          "tipo": "texto",
          "requerido": true,
          "max": 52
        },
        {
          "id": "textoSeccionDatos",
          "etiqueta": "Nombre del bloque de datos (lectores de pantalla)",
          "tipo": "texto",
          "requerido": true,
          "max": 20
        },
        {
          "id": "etiquetaNombre",
          "etiqueta": "Etiqueta del campo nombre",
          "tipo": "texto",
          "requerido": true,
          "max": 20
        },
        {
          "id": "etiquetaEmpresa",
          "etiqueta": "Etiqueta del campo empresa",
          "tipo": "texto",
          "requerido": true,
          "max": 20
        },
        {
          "id": "etiquetaCorreo",
          "etiqueta": "Etiqueta del campo correo",
          "tipo": "texto",
          "requerido": true,
          "max": 20
        },
        {
          "id": "etiquetaTelefono",
          "etiqueta": "Etiqueta del campo teléfono",
          "tipo": "texto",
          "requerido": true,
          "max": 20
        },
        {
          "id": "errorNombre",
          "etiqueta": "Mensaje si falta el nombre",
          "tipo": "texto",
          "requerido": true,
          "max": 36
        },
        {
          "id": "errorContacto",
          "etiqueta": "Mensaje si falta correo o teléfono",
          "tipo": "texto",
          "requerido": true,
          "max": 58
        },
        {
          "id": "errorGenerar",
          "etiqueta": "Mensaje si falla el envío",
          "tipo": "texto",
          "requerido": true,
          "max": 66
        }
      ]
    },
    {
      "id": "pie",
      "titulo": "Pie de página",
      "campos": [
        { "id": "texto", "etiqueta": "Texto", "tipo": "texto", "max": 120 },
        {
          "id": "redes",
          "etiqueta": "Enlaces",
          "tipo": "lista",
          "maxItems": 6,
          "nombreItem": "enlace",
          "campoTitulo": "texto",
          "campos": [
            { "id": "texto", "etiqueta": "Texto", "tipo": "texto", "requerido": true, "max": 20 },
            { "id": "destino", "etiqueta": "Enlace", "tipo": "enlace", "requerido": true }
          ]
        }
      ]
    }
